<view class="page"><view class="intro"><text class="title">{{categoryName}}</text><text>{{questionCount}} 道精选面试题</text></view><view class="list"><view wx:for="{{questions}}" wx:key="id" class="question-card" bindtap="goQuestion" data-id="{{item.id}}"><view class="card-top"><text class="difficulty">{{item.difficulty}}</text><text class="status {{item.statusClass}}">{{item.status}}</text></view><text class="question-title">{{item.title}}</text><view class="tags"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view></view></view></view>
