<view class="page"><view class="tabs"><view class="tab {{mode === 'mistakes' ? 'active' : ''}}" bindtap="selectMode" data-mode="mistakes">错题本</view><view class="tab {{mode === 'favorites' ? 'active' : ''}}" bindtap="selectMode" data-mode="favorites">我的收藏</view></view><view wx:if="{{questions.length}}" class="list"><view wx:for="{{questions}}" wx:key="id" class="question-card" bindtap="goQuestion" data-id="{{item.id}}"><view class="card-row"><text class="category">{{item.category}}</text><text class="status {{item.statusClass}}">{{item.status}}</text></view><text class="title">{{item.title}}</text><text class="continue">继续复习 ›</text></view></view><view wx:else class="empty"><text class="empty-icon">{{mode === 'mistakes' ? '◎' : '♡'}}</text><text class="empty-title">{{mode === 'mistakes' ? '还没有需要复习的题目' : '还没有收藏题目'}}</text><text class="empty-desc">{{mode === 'mistakes' ? '答题后标记为“模糊”或“未掌握”，它们会出现在这里。' : '在题目详情页点击收藏，方便之后集中复习。'}}</text><button class="empty-button" bindtap="goPractice">去随机刷题</button></view></view>
